# Hostinger (LiteSpeed/Apache): serve the single-page app for every page URL
# (/formations, /contact, ...) so direct links and page refreshes work.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # The site's main address is www.cicexf.com: send cicexf.com and the former
  # address cicexf.gestionsaas.org there permanently (same page path)
  RewriteCond %{HTTP_HOST} ^(cicexf\.com|cicexf\.gestionsaas\.org)$ [NC]
  RewriteRule ^(.*)$ https://www.cicexf.com/$1 [R=301,L]
  RewriteRule ^index\.html$ - [L]
  # Missing build files must stay real 404s (never the HTML page), otherwise an
  # outdated page loads HTML as JavaScript and stays blank
  RewriteRule ^assets/ - [L]
  # Each page has its own HTML (title, description, canonical for search engines):
  # /formations -> formations.html, /contact -> contact.html, ...
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z-]+)$ /$1.html [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# The page must always be revalidated so visitors get the latest version after
# each deployment; hashed build files can be cached for a long time.
<IfModule mod_headers.c>
  # Security headers
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|webp|png|jpg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>
