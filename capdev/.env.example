# Adresse e-mail de l'administrateur principal (seul compte qui voit l'onglet Administration)
ADMIN_EMAIL=admin@capdev.org
# Empreinte du mot de passe : lancer `npm run hash-password` et coller le résultat ici
ADMIN_PASSWORD_HASH=
# Secret de signature des sessions (une longue chaîne aléatoire)
SESSION_SECRET=
# Clé Gemini : assistant virtuel et traduction automatique (facultatif, sinon mode hors ligne)
GEMINI_API_KEY=
# Dossier où sont enregistrés les contenus, messages et images
DATA_DIR=./data
PORT=3000
