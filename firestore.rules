rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Comptes administrateurs : authentification Firebase obligatoire
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['elearningciv@gmail.com', 'cabinetcicexf@gmail.com'];
    }

    // Statistiques de visites : écriture anonyme limitée, lecture admin
    match /visits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly(['visitorId', 'sessionId', 'timestamp', 'email', 'userAgent', 'page'])
        && request.resource.data.page is string
        && request.resource.data.page.size() < 100;
      allow read, update, delete: if isAdmin();
    }

    // Abonnés newsletter : inscription publique, consultation admin
    match /subscribers/{subscriberId} {
      allow create, update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['email', 'visitorId', 'subscribedAt', 'lastVisitAt', 'isSubscribed'])
        && request.resource.data.email == subscriberId
      );
      allow read, delete: if isAdmin();
    }

    // Prospects (inscriptions, devis, contact) : soumission publique, données personnelles réservées à l'admin
    match /prospects/{prospectId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'type', 'target', 'session', 'modality', 'company', 'participants', 'notes', 'channel', 'status', 'visitorId', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.notes is string && request.resource.data.notes.size() < 5000
        && request.resource.data.status == 'Nouveau';
      allow read, update, delete: if isAdmin();
    }

    // Numérotation des factures proforma : un compteur par année, qui n'avance que de 1,
    // et seulement si la facture de ce numéro est créée dans la même transaction.
    match /invoice_counters/{year} {
      allow read: if true;
      allow create: if year.matches('^20[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == 1
        && existsAfter(/databases/$(database)/documents/proformas/$(year + '-1'));
      allow update: if request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == resource.data.last + 1
        && existsAfter(/databases/$(database)/documents/proformas/$(year + '-' + string(request.resource.data.last)));
      allow delete: if false;
    }

    // Factures proforma : créées par ADILINE (une seule fois par numéro), consultées par l'admin
    match /proformas/{invoiceId} {
      allow create: if invoiceId.matches('^20[0-9]{2}-[0-9]+$')
        && request.resource.data.seq == int(invoiceId.split('-')[1])
        && request.resource.data.year == int(invoiceId.split('-')[0])
        && getAfter(/databases/$(database)/documents/invoice_counters/$(invoiceId.split('-')[0])).data.last == request.resource.data.seq
        && request.resource.data.number is string && request.resource.data.number.size() == 10
        && request.resource.data.status == 'Émise'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['number', 'seq', 'year', 'status', 'formation', 'modality', 'session', 'duration', 'participants', 'unitPrice', 'subtotal', 'discount', 'total', 'client', 'source', 'visitorId', 'createdAt']);
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Discussions avec ADILINE : écrites uniquement par le serveur, consultées par l'admin
    match /adiline_conversations/{conversationId} {
      allow read, delete: if isAdmin();
      match /messages/{messageId} {
        allow read, delete: if isAdmin();
      }
    }

    // E-learning : chaque apprenant ne lit et ne modifie que son propre profil.
    // La progression et les certificats sont écrits uniquement par le serveur (fonction elearning).
    function shortText(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }
    function validLearner(d) {
      return d.keys().hasOnly(['nom', 'prenom', 'telephone', 'email', 'pays', 'activite', 'formation', 'experience', 'consent', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['nom', 'prenom', 'telephone', 'email', 'pays', 'activite', 'formation', 'experience', 'consent', 'createdAt', 'updatedAt'])
        && shortText(d.nom, 80) && shortText(d.prenom, 120) && shortText(d.telephone, 30)
        && shortText(d.pays, 80) && shortText(d.activite, 120) && shortText(d.formation, 120) && shortText(d.experience, 40)
        && d.email == request.auth.token.email
        && d.consent == true
        && d.updatedAt == request.time;
    }
    match /learners/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && validLearner(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == uid
        && validLearner(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow delete: if isAdmin();

      match /progress/{courseId} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow write: if false;
      }
      // Inscription à une certification, confirmée par l'apprenant (une seule fois par certification)
      match /enrollments/{courseId} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['courseId', 'enrolledAt'])
          && request.resource.data.courseId == courseId
          && courseId.matches('^[a-z0-9-]{3,60}$')
          && request.resource.data.enrolledAt == request.time
          && (!exists(/databases/$(database)/documents/elearning_courses/$(courseId))
              || get(/databases/$(database)/documents/elearning_courses/$(courseId)).data.status == 'open');
        allow update, delete: if false;
      }
      // Chapitre en cours (réponses non corrigées), pour reprendre plus tard : réservé à l'apprenant
      match /drafts/{courseId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['stepId', 'state', 'savedAt'])
          && shortText(request.resource.data.stepId, 20)
          && request.resource.data.state is string && request.resource.data.state.size() < 30000
          && request.resource.data.savedAt == request.time;
      }
    }
    // Suivi des parcours dans l'administration
    match /{path=**}/progress/{courseId} {
      allow read: if isAdmin();
    }
    match /{path=**}/enrollments/{courseId} {
      allow read: if isAdmin();
    }
    // Ouverture des certifications e-learning : lecture publique, choix de l'administrateur.
    // Une certification supprimée ne peut plus être rouverte (suppression définitive).
    match /elearning_courses/{courseId} {
      allow read: if true;
      allow create: if isAdmin() && validCourseStatus();
      allow update: if isAdmin() && resource.data.status != 'deleted' && validCourseStatus();
      allow delete: if false;
    }
    function validCourseStatus() {
      return request.resource.data.keys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['open', 'closed', 'deleted']
        && request.resource.data.updatedAt == request.time;
    }
    // Certificats : vérification publique d'un numéro précis, liste réservée à l'admin
    match /certificates/{number} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }

    // Contenus publics du site : lecture libre, modification admin uniquement
    match /formations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blog_posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /accompagnements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /realisations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
